# Environment configuration for AI Code Reviewer Assistant

# Environment & Server
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=INFO

# PostgreSQL 16 Database
POSTGRES_USER=aicr_user
POSTGRES_PASSWORD=aicr_password
POSTGRES_DB=aicr_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://aicr_user:aicr_password@localhost:5432/aicr_db
DATABASE_URL_SYNC=postgresql://aicr_user:aicr_password@localhost:5432/aicr_db

# Redis 7 (Broker & Results)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Qdrant Vector & Symbol Database
QDRANT_HOST=localhost
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334

# VCS Webhook Secrets
GITHUB_WEBHOOK_SECRET=replace_with_github_webhook_secret
GITLAB_WEBHOOK_SECRET=replace_with_gitlab_webhook_secret

# AI Model Configuration (for future phases)
MODEL_PROVIDER=openai_compatible
MODEL_ENDPOINT=http://localhost:8000/v1
MODEL_API_KEY=dummy_key
MODEL_NAME=Qwen/Qwen2.5-Coder-7B-Instruct

# OpenAI API (optional - enables GPT-4o-mini AI review enrichment layer)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
